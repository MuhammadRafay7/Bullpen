FROM ubuntu:24.04

ARG NODE_MAJOR=20
ARG BULLPEN_VERSION=latest
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  BULLPEN_HOME=/bullpen \
  BULLPEN_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3100 \
  HOME=/home/bullpen \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  BULLPEN_VERSION=${BULLPEN_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 bullpen \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 bullpen \
  && mkdir -p /bullpen /home/bullpen/workspace \
  && chown -R bullpen:bullpen /bullpen /home/bullpen \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/bullpen"]
WORKDIR /home/bullpen/workspace
EXPOSE 3100
USER bullpen

CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$BULLPEN_HOME\"; npx --yes \"bullpen@${BULLPEN_VERSION}\" onboard --yes --data-dir \"$BULLPEN_HOME\""]
